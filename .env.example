DATABASE_URL="postgresql://videosystem:change-me@localhost:5432/videosystem?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Solo activar detrás de un proxy inverso controlado por la aplicación.
TRUST_PROXY="false"

# LiveKit self-hosted server
LIVEKIT_URL="ws://localhost:7880"
# Optional internal URL for LiveKit administration when the app runs in Compose.
# LIVEKIT_ADMIN_URL="http://livekit:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="replace-me"

# SMTP local: Mailpit (compatible con el puerto SMTP 1025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_FROM="VideoSystem <noreply@videosystem.local>"

# Retention in days
MESSAGE_RETENTION_DAYS="30"
# Maximum access window after the scheduled start; no end time is required when scheduling.
MEETING_ACCESS_WINDOW_HOURS="24"
