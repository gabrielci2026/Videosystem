DATABASE_URL=postgresql://videosystem:CHANGE_ME@postgres:5432/videosystem?schema=public
APP_URL=https://video-node.tailnet.ts.net
NEXT_PUBLIC_APP_URL=https://video-node.tailnet.ts.net
TRUST_PROXY=true
# Loopback es el binding recomendado con `tailscale serve 3000`.
# Si Caddy escucha directamente en la interfaz Tailscale, usa aquí la IP 100.x del nodo.
PUBLISH_HOST=127.0.0.1
LIVEKIT_URL=wss://video-node.tailnet.ts.net:7880
LIVEKIT_ADMIN_URL=http://livekit:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_NODE_IP=TAILSCALE_IP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=VideoSystem <noreply@example.com>
MESSAGE_RETENTION_DAYS=30
# Maximum access window after scheduledAt; organizers do not need to enter an end time.
MEETING_ACCESS_WINDOW_HOURS=24
POSTGRES_USER=videosystem
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=videosystem
