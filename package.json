{
  "name": "video-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node scripts/dev-guard.mjs",
    "build": "node scripts/build-guard.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
